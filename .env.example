# =============================================================================
# Stratum — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# See docs/setup.md for a full walkthrough.
#
# REQUIRED (blank — you must fill these in):
#   GITHUB_APP_ID, GITHUB_WEBHOOK_SECRET,
#   GITHUB_OAUTH_CLIENT_ID, GITHUB_OAUTH_CLIENT_SECRET
#
# OPTIONAL (blank — leave blank to skip that feature):
#   GROQ_API_KEY, GITHUB_PERSONAL_ACCESS_TOKEN
#
# PRE-FILLED (leave as-is for a standard Docker Compose setup):
#   Everything else — DB, Redis, Django, Celery, Embedding service
# =============================================================================

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
# Generate a strong secret key before going to production:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-random-50-character-string-before-production

# DEBUG=True: allows all hosts (including ngrok tunnels), shows detailed errors.
# DEBUG=False (production): only ALLOWED_HOSTS are accepted.
DEBUG=True

# Comma-separated list of allowed hostnames. Only used when DEBUG=False.
# Add your ngrok/Cloudflare tunnel domain here for production-like local testing.
# Example: localhost,127.0.0.1,abc123.ngrok.io
ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------------------
# PostgreSQL 16
# Pre-filled for Docker Compose. Change only if you know what you're doing.
# Docker Compose:      DB_HOST=postgres,   DB_PORT=5432
# Local dev (dev.yml): DB_HOST=localhost,  DB_PORT=5433
# ---------------------------------------------------------------------------
DB_NAME=stratum
DB_USER=stratum
DB_PASSWORD=postgres123
DB_HOST=postgres
DB_PORT=5432

# ---------------------------------------------------------------------------
# Redis 7
# Pre-filled for Docker Compose. Change only for local dev.
# Docker Compose:      redis://redis:6379
# Local dev (dev.yml): redis://localhost:6380
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ---------------------------------------------------------------------------
# GitHub App  *** REQUIRED — must fill in ***
# See docs/setup.md Step 2 for step-by-step creation instructions.
# ---------------------------------------------------------------------------
GITHUB_APP_ID=

# Path to the .pem private key file downloaded when you created the GitHub App.
#
#   Docker Compose (default):
#     Leave as-is. Place your .pem at ./secrets/stratum-app.private-key.pem on the host.
#     The ./secrets/ directory is mounted read-only into the container at /secrets/.
#
#   Local dev without Docker:
#     Change to the absolute path on your machine, e.g.:
#     Windows: C:\Users\you\stratum\secrets\stratum-app.private-key.pem
#     Mac/Linux: /home/you/stratum/secrets/stratum-app.private-key.pem
#
GITHUB_APP_PRIVATE_KEY_PATH=/secrets/stratum-app.private-key.pem

# The webhook secret you chose when creating the GitHub App.  *** REQUIRED ***
# Used to verify every incoming webhook is genuinely from GitHub.
GITHUB_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# GitHub OAuth  *** REQUIRED — must fill in ***
# Used for dashboard login (there is no username/password — users log in with GitHub).
# Create at: https://github.com/settings/developers → OAuth Apps → New OAuth App
# Callback URL to set in GitHub: http://localhost:8000/accounts/github/login/callback/
# ---------------------------------------------------------------------------
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Groq API  *** OPTIONAL ***
# Stratum uses Groq to generate plain-English "how to fix this" suggestions
# that appear directly on PR comments for critical and high severity findings.
#
# Without a key: all findings are still posted on PRs — just without the
# "Suggested fix:" section. Everything else works normally.
#
# With a key: Stratum calls Groq's llama-3.1-8b-instant model (free tier,
# 14,400 requests/day) for every critical/high finding. Results are cached
# in Redis for 24 hours so the same pattern is only called once.
#
# Get a free key at: https://console.groq.com
# Set ENABLE_LLM_SUGGESTIONS=false to disable Groq calls entirely.
# ---------------------------------------------------------------------------
GROQ_API_KEY=
ENABLE_LLM_SUGGESTIONS=true

# ---------------------------------------------------------------------------
# Personal Access Token (PAT)  *** OPTIONAL ***
# Only needed if you want to connect private repos that your GitHub App
# does not have access to.
# Scopes required: repo (full access)
# Generate at: https://github.com/settings/tokens/new
# ---------------------------------------------------------------------------
GITHUB_PERSONAL_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Embedding microservice (FastAPI + CodeBERT)
# Pre-filled for Docker Compose. Change only for local dev.
# Docker Compose:  http://embedding:8001
# Local dev:       http://localhost:8001
# ---------------------------------------------------------------------------
EMBEDDING_SERVICE_URL=http://embedding:8001

# ---------------------------------------------------------------------------
# Storage
# STORE_RAW_CODE=false (default): only embeddings + metadata stored in DB.
# STORE_RAW_CODE=true:  raw source code also stored in the DB.
#   Required for the calibrated duplicate similarity score display (84% vs 98%).
#   Only enable if you are self-hosting and are comfortable with code in the DB.
# ---------------------------------------------------------------------------
STORE_RAW_CODE=false
